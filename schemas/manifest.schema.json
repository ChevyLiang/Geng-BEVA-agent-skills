{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "module",
    "input",
    "out_dir",
    "outputs",
    "warnings",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "success",
        "error"
      ]
    },
    "module": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "out_dir": {
      "type": "string"
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
